{
  "rules": {
    "users": {
      "$uid": {
        // Users can only read and write their own profile, contacts, walks, and alerts
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "contacts": {
          ".indexOn": ["isPrimary", "createdAt"]
        },
        "alerts": {
          ".indexOn": ["timestamp", "alertType"]
        },
        "safewalks": {
          ".indexOn": ["startTime", "status"]
        }
      }
    },
    "unsafe_reports": {
      // Authenticated users can read all community reports for the unsafe area chart & stats
      ".read": "auth != null",
      // Authenticated users can write/submit a new report with their own userId stamp
      "$reportId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['userId', 'category', 'description', 'timestamp', 'latitude', 'longitude'])"
      },
      ".indexOn": ["category", "timestamp"]
    }
  }
}
